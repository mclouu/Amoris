# Création d'un .gitignore adapté pour Python, PyCharm et les environnements virtuels
@"
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyCharm
.idea/

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs & OS specific
*.log
.DS_Store
Thumbs.db
"@ | Out-File -Encoding utf8 .gitignore

# Cache & Database locales
cache/